# ============================================================
# Variables d'environnement — Benchrs legacy-app (fork downgradé)
# ============================================================
# Copiez ce fichier en .env.local pour un run local, OU renseignez ces
# variables dans les "Environment Variables" du projet Vercel.
#
# ⚠️ Le .env.production versionné ne contient que des PLACEHOLDERS pour que le
#    build passe. Il NE contient AUCUN secret et NE doit PAS servir en prod.

# ── Supabase (REQUIS) ──────────────────────────────────────
# Depuis Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<votre-projet>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<votre-anon-key>
# Clé service role (serveur uniquement — NE JAMAIS exposer côté client)
SUPABASE_SERVICE_ROLE_KEY=<votre-service-role-key>

# ── Cron / sécurité (REQUIS si crons activés) ──────────────
CRON_SECRET=<un-secret-aléatoire>

# ── IA (optionnel — génération de séances / rapports) ──────
MISTRAL_API_KEY=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
OLLAMA_URL=

# ── Email SMTP (optionnel — notifications email) ───────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
