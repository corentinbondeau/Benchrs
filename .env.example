# Variable pour la bascule automatique vers le fork legacy (legacy-app).
# Si définie, les vieux navigateurs (iPhone 7 / iOS ≤14, vieux Safari,
# Android ≤8) détectés par User-Agent sont redirigés vers cette URL.
# Laisser vide/non défini pour désactiver la bascule.
# Exemple : https://legacy.mondomaine.com  ou  https://benchrs-legacy-app.vercel.app
NEXT_PUBLIC_LEGACY_URL=

# Base URL de l'API DOFA (championnats FFF). L'ancien hôte
# api-dofa.prd-aws.fff.fr n'existe plus en DNS. Valeur par défaut si non
# définie : https://api-dofa.fff.fr (protégé par Akamai, import automatique
# actuellement indisponible côté source — voir DofaUnavailableError).
DOFA_BASE_URL=

